{
  "name": "publicmcp",
  "version": "1.0.0",
  "description": "MCP server for Maine fire danger and burn permits, plus marine weather forecasting, tides, and route planning from free public sources",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "maine-burn-permit": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "prepare": "npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "maine",
    "burn-permit",
    "fire-danger",
    "automation",
    "marine-weather",
    "marine-forecast",
    "tides",
    "route-planning",
    "noaa",
    "open-meteo"
  ],
  "author": "stringtheoryaccelerator",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/stringtheoryaccelerator/publicmcp.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.22.0",
    "express": "^5.1.0",
    "puppeteer": "^24.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "typescript": "^5.0.0"
  }
}
